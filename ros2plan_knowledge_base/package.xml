<?xml version="1.0"?>
<package format="3">
  <name>ros2plan_knowledge_base</name>
  <version>2.0.0</version>
  <description>
      Knowledge base for ROS2Plan. Stores and serves the planning model (domain and state).
  </description>
  <maintainer email="amar.halilovic@uni-ulm.de">Amar Halilovic</maintainer>
  <author email="michael.cashmore@kcl.ac.uk">michael</author>
  <license>BSD</license>
  <url type="website">https://github.com/ah96/ROS2Plan</url>
  <url type="repository">https://github.com/ah96/ROS2Plan</url>
  <url type="bugtracker">https://github.com/ah96/ROS2Plan/issues</url>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>diagnostic_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>ros2plan_knowledge_msgs</depend>
  <depend>ros2plan_dependencies</depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>launch_testing_ament_cmake</test_depend>
  <test_depend>ros_testing</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
