<?xml version="1.0"?>
<package format="3">
  <name>ros2plan_sensing_interface</name>
  <version>2.0.0</version>
  <description>ROS2Plan sensing interface — subscribes to topics/services and maintains KB predicate state</description>

  <maintainer email="amarhalilovic96@gmail.com">ROS2Plan maintainers</maintainer>
  <license>BSD</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>ros2plan_knowledge_msgs</depend>
  <depend>diagnostic_msgs</depend>
  <depend>ament_index_python</depend>

  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
