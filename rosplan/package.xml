<?xml version="1.0"?>
<package format="3">
  <name>rosplan</name>
  <version>2.0.0</version>
  <description>ROSPlan metapackage</description>
  <maintainer email="amarhalilovic96@gmail.com">ROSPlan maintainers</maintainer>
  <license>BSD</license>
  <url type="website">https://github.com/KCL-Planning/ROSPlan</url>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>rosplan_knowledge_msgs</exec_depend>
  <exec_depend>rosplan_dispatch_msgs</exec_depend>
  <exec_depend>rosplan_dependencies</exec_depend>
  <exec_depend>rosplan_planning_system</exec_depend>
  <exec_depend>rosplan_knowledge_base</exec_depend>
  <exec_depend>rosplan_sensing_interface</exec_depend>
  <exec_depend>rosplan_action_interface</exec_depend>
  <exec_depend>rosplan_rqt</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
