<library path="ros2plan_rqt">

  <class name="ROS2PlanDispatcher" type="ros2plan_rqt.dispatcher.ROS2PlanDispatcher" base_class_type="rqt_gui_py::Plugin">
    <description>
      Information on the current plan, actions and dispatch state in ROS2Plan.
    </description>
    <qtgui>
      <group>
        <icon type="theme">folder</icon>
        <label>ROS2Plan</label>
        <statustip>Plugins related to the ROS2Plan PDDL planning system.</statustip>
      </group>
      <label>ROS2Plan dispatcher</label>
      <icon type="theme">applications-science</icon>
      <statustip>ROS2Plan dispatch info pane.</statustip>
    </qtgui>
  </class>

  <class name="ROS2PlanActionDispatcher" type="ros2plan_rqt.action_dispatcher.ROS2PlanActionDispatcher" base_class_type="rqt_gui_py::Plugin">
    <description>
